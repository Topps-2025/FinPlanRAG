\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The FinPlan{} decision interface. Evidence available at the chosen decision time induces a credal state. The planner chooses an output action or an evidence action. Waiting advances the decision time and is charged a delay cost. Point answers, credible sets, and abstentions share the same state and loss.}}{5}{figure.caption.9}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:interface}{{1}{5}{The \method {} decision interface. Evidence available at the chosen decision time induces a credal state. The planner chooses an output action or an evidence action. Waiting advances the decision time and is charged a delay cost. Point answers, credible sets, and abstentions share the same state and loss}{figure.caption.9}{}}
