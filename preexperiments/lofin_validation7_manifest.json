  "template_bank": {
    "h1": {
      "question": "What was {Name}'s revenue in the first half of {Y}?",
      "gold_docs": ["{TICKER}_{Y}Q2_10Q"],
      "stratum": "h1_alias",
      "rationale": "H1 数字（six months ended June 30）只出现在 Q2 10-Q 的收入表；period-aware 义务键必须把 'first half' 映射到 Q2 10-Q，而不是年度 10-K。"
    },
    "h1_9m": {
      "question": "How did {Name}'s revenue change from the first half of {Y} to the first three quarters of {Y}?",
      "gold_docs": ["{TICKER}_{Y}Q2_10Q", "{TICKER}_{Y}Q3_10Q"],
      "stratum": "multi_quarter",
      "rationale": "H1 在 Q2 10-Q，9M 在 Q3 10-Q；同一财政年度两个不同期间文件的义务键必须分开。"
    },
    "q1q2": {
      "question": "Compare {Name}'s revenue in the first quarter of {Y} with the second quarter of {Y}.",
      "gold_docs": ["{TICKER}_{Y}Q1_10Q", "{TICKER}_{Y}Q2_10Q"],
      "stratum": "multi_quarter",
      "rationale": "同一财政年度 Q1 与 Q2 10-Q 是两件独立文件；entity-year 义务键会把它们折叠成同一义务。"
    },
    "h2": {
      "question": "What was {Name}'s revenue in the second half of {Y}?",
      "gold_docs": ["{TICKER}_{Y}Q3_10Q", "{TICKER}_{Y}_10K"],
      "stratum": "h2_derived",
      "rationale": "H2 = FY − 9M，需要 Q3 10-Q（nine months）与 FY 10-K（annual）两件文件推导；'second half' 不能只落到年度 10-K。"
    },
    "fy_q1n": {
      "question": "How did {Name}'s revenue for fiscal year {Y} compare with its revenue in the first quarter of {Y+1}?",
      "gold_docs": ["{TICKER}_{Y}_10K", "{TICKER}_{Y+1}Q1_10Q"],
      "stratum": "filing_boundary",
      "rationale": "跨财政年度边界：FY 数字在 FY 10-K，下一年 Q1 数字在下一年 Q1 10-Q。"
    }
  },
